+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/err.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/pinctrl/devinfo.h>
+#include "core.h"
+
+static ssize_t
+append_line(char *buf, ssize_t offset, const char *s)
+{
+	BUG_ON(offset < 0);
+	ssize_t len = strscpy(buf + offset, s, PAGE_SIZE - 1 - offset);
+	if (len >= 0) {
+		len += offset;  // now guaranteed to be < PAGE_SIZE - 1
+		buf[len++] = '\n';
+		buf[len] = 0;
+	}
+	return len;
+}
+
+static ssize_t
+available_states_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct pinctrl *p = dev->pins->p;
+	struct pinctrl_state *state;
+	ssize_t ret = 0;
+
+	list_for_each_entry(state, &p->states, node) {
+		ret = append_line(buf, ret, state->name);
+		if (ret < 0)
+			break;
+	}
+
+	return ret;
+}
+
+static ssize_t
+state_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct pinctrl *p = dev->pins->p;
+	ssize_t ret = 0;
+
+	if (p->state)
+		ret = append_line(buf, ret, p->state->name);
+
+	return ret;
+}
+
+static struct pinctrl_state *
+sysfs_pinctrl_lookup_state(struct pinctrl *p, const char *name)
+{
+	struct pinctrl_state *state;
+
+	list_for_each_entry(state, &p->states, node) {
+		if (sysfs_streq(state->name, name))
+			return state;
+	}
+
+	return NULL;
+}
+
+static ssize_t
+state_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t len)
+{
+	struct pinctrl *p = dev->pins->p;
+	struct pinctrl_state *state = sysfs_pinctrl_lookup_state(p, buf);
+	if (!state) {
+		dev_err(dev, "pinctrl state not found\n");
+		return -ENODEV;
+	}
+
+	int ret = pinctrl_select_state(p, state);
+	if (ret < 0) {
+		dev_err(dev, "select pinctrl state \"%s\": error %d\n",
+				state->name, ret);
+		return ret;
+	}
+
+	return len;
+}
+
+static DEVICE_ATTR_RO(available_states);
+static DEVICE_ATTR_RW(state);
+
+static struct attribute *sysfs_pinctrl_attrs[] = {
+	&dev_attr_available_states.attr,
+	&dev_attr_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(sysfs_pinctrl);
+
+static int sysfs_pinctrl_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	if (!dev->pins || !dev->pins->p) {
+		dev_err(dev, "No pinctrl available\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static const struct of_device_id sysfs_pinctrl_of_match[] = {
+	{ .compatible = "sysfs-pinctrl" },
+	{ .compatible = "bone-pinmux-helper" },  // compat
+	{},
+};
+MODULE_DEVICE_TABLE(of, sysfs_pinctrl_of_match);
+
+static struct platform_driver sysfs_pinctrl_driver = {
+	.probe		= sysfs_pinctrl_probe,
+	.driver = {
+		.name		= "sysfs-pinctrl",
+		.owner		= THIS_MODULE,
+		.of_match_table	= sysfs_pinctrl_of_match,
+		.dev_groups	= sysfs_pinctrl_groups,
+	},
+};
+
+module_platform_driver(sysfs_pinctrl_driver);
+
+MODULE_AUTHOR("Matthijs van Duin <matthijsvanduin@gmail.com>");
+MODULE_DESCRIPTION("sysfs-controllable pinctrl");
+MODULE_LICENSE("GPL");
