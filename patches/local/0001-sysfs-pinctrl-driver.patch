From 90724af0fee65c7256dfdaee48d8ad8b22d221b7 Mon Sep 17 00:00:00 2001
From: Matthijs van Duin <matthijsvanduin@gmail.com>
Date: Tue, 14 Jan 2025 03:04:05 +0100
Subject: [PATCH] sysfs-pinctrl driver

---
 drivers/pinctrl/Kconfig         |   7 ++
 drivers/pinctrl/Makefile        |   1 +
 drivers/pinctrl/sysfs-pinctrl.c | 155 ++++++++++++++++++++++++++++++++
 3 files changed, 163 insertions(+)
 create mode 100644 drivers/pinctrl/sysfs-pinctrl.c

diff --git a/drivers/pinctrl/Kconfig b/drivers/pinctrl/Kconfig
index 7dfb7190580e..896d72f658a0 100644
--- a/drivers/pinctrl/Kconfig
+++ b/drivers/pinctrl/Kconfig
@@ -31,6 +31,13 @@ config DEBUG_PINCTRL
 	help
 	  Say Y here to add some extra checks and diagnostics to PINCTRL calls.
 
+config SYSFS_PINCTRL
+	tristate ""
+	depends on OF
+	help
+	  Allows creating virtual devices whose pinctrl state can be configured
+	  from userspace via sysfs.
+
 config PINCTRL_AMD
 	bool "AMD GPIO pin control"
 	depends on HAS_IOMEM
diff --git a/drivers/pinctrl/Makefile b/drivers/pinctrl/Makefile
index dd6cda270294..f30f6ab0dca3 100644
--- a/drivers/pinctrl/Makefile
+++ b/drivers/pinctrl/Makefile
@@ -8,6 +8,7 @@ obj-$(CONFIG_PINMUX)		+= pinmux.o
 obj-$(CONFIG_PINCONF)		+= pinconf.o
 obj-$(CONFIG_GENERIC_PINCONF)	+= pinconf-generic.o
 obj-$(CONFIG_OF)		+= devicetree.o
+obj-$(CONFIG_SYSFS_PINCTRL)	+= sysfs-pinctrl.o
 
 obj-$(CONFIG_PINCTRL_AMD)	+= pinctrl-amd.o
 obj-$(CONFIG_PINCTRL_APPLE_GPIO) += pinctrl-apple-gpio.o
diff --git a/drivers/pinctrl/sysfs-pinctrl.c b/drivers/pinctrl/sysfs-pinctrl.c
new file mode 100644
index 000000000000..d9b1f21f27eb
--- /dev/null
+++ b/drivers/pinctrl/sysfs-pinctrl.c
@@ -0,0 +1,155 @@
+/*
+ * virtual device for sysfs-controllable pinctrl
+ *
