From 2294e37514f2b440a8738a07c1615e4eee208f16 Mon Sep 17 00:00:00 2001
From: Matthijs van Duin <matthijsvanduin@gmail.com>
Date: Thu, 14 Aug 2025 09:00:38 +0200
Subject: [PATCH 10/12] clocksource: add snapshot sysfs attribute

---
 kernel/time/clocksource.c | 37 +++++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/kernel/time/clocksource.c b/kernel/time/clocksource.c
index ae862ad9642c..a01c998da3f6 100644
--- a/kernel/time/clocksource.c
+++ b/kernel/time/clocksource.c
@@ -1487,10 +1487,47 @@ static ssize_t available_clocksource_show(struct device *dev,
 }
 static DEVICE_ATTR_RO(available_clocksource);
 
+/**
+ * snapshot_show - sysfs interface for getting system time snapshot
+ * @dev:	unused
+ * @attr:	unused
+ * @buf:	char buffer to be filled with snapshot info
+ *
+ * Provides sysfs interface for ktime_get_snapshot()
+ */
+static ssize_t snapshot_show(struct device *dev,
+			     struct device_attribute *attr,
+			     char *buf)
+{
+	struct system_time_snapshot snapshot;
+	ssize_t count = 0;
+
+	mutex_lock(&clocksource_mutex);
+	count = snprintf(buf, PAGE_SIZE, "clocksource=%s\n", curr_clocksource->name);
+	ktime_get_snapshot(&snapshot);
+	mutex_unlock(&clocksource_mutex);
+
+	count += snprintf(buf + count, max((ssize_t)PAGE_SIZE - count, (ssize_t)0),
+			"clocksource_changes=%u\n"
+			"clock_was_set=%u\n"
+			"cycles=%llu\n"
+			"real_time=%lld\n"
+			"raw_time=%lld\n",
+			snapshot.cs_was_changed_seq,
+			snapshot.clock_was_set_seq,
+			snapshot.cycles,
+			snapshot.real,
+			snapshot.raw );
+
+	return count;
+}
+static DEVICE_ATTR_RO(snapshot);
+
 static struct attribute *clocksource_attrs[] = {
 	&dev_attr_current_clocksource.attr,
 	&dev_attr_unbind_clocksource.attr,
 	&dev_attr_available_clocksource.attr,
+	&dev_attr_snapshot.attr,
 	NULL
 };
 ATTRIBUTE_GROUPS(clocksource);
-- 
